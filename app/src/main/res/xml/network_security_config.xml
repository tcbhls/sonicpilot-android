<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许部分国内音乐 CDN 与用户自建局域网 Subsonic/Meting 音源使用 HTTP -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
